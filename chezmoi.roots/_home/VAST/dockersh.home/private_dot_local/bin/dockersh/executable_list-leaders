#! /usr/bin/env bash
# vim: set ft=sh sw=4 sts=4 et:

n_leaders=${1:-10};
[[ $n_leaders != "all" ]] || unset n_leaders;

ESC=$(printf "\e");
CLR_START="${ESC}[92;1m";
CLR_RESET="${ESC}[0m";
SED_MARK_LATEST_LEADER=$(printf '$s/:\|(.*)$/:|%s\\1 <--%s/' "${CLR_START}" "${CLR_RESET}");

function list_all_leaders ()
{
    qf 'docker.log$' | POST="sed -Ee 's|^([^:]+):([^ ]+) env env_id=1 .*$|\\1:\\2|;'" xgp 'env_id=1 started' | fixcol_and_sort 2 | sed -Ee 's/\/docker.log:\|/:|/; s/[:|]+01:\|/:|:|:|:|:|01:|Leader started/g' -e "${SED_MARK_LATEST_LEADER}"
};
if [[ -v n_leaders ]]; then
    list_all_leaders | tail -n $n_leaders;
else
    list_all_leaders;
fi

