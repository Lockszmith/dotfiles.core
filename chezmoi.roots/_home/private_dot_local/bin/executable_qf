#! /usr/bin/env bash

DEPTH=${DEPTH:-${D:-4}}
TYPE=${TYPE:-${T:-f}}
PRUNE="${PRUNE:-}"

[ ${#PRUNE} -gt 0 ] || PRUNE="( -type d -name vapi -or -name traces ) -prune -or"
[ "${X:-}" != ":" ] || XB=:
[ "${X:-}" != ":" ] || XE=:
XB="${XB:-^.*/}"
XE="${XE:-.*$}"

[ "${XB:-}" != ":" ] || XB=
[ "${XE:-}" != ":" ] || XE=

FD="$(command -v fd)"
QFD="${QFD:-.}"
if [[ -z "$FD" || "$FD" = ":" ]]; then
    FIND="find '${QFD}' -regextype egrep"
    (find "${QFD}" --version 2>&1 || true) | grep -q 'GNU findutils' || FIND="find -E '${QFD}'"

    [ ${#PRUNE} -gt 0 ] || PRUNE="( -type d -name vapi -or -name traces ) -prune -or"
#   ${FIND} -maxdepth ${DEPTH}                  ${PRUNE} -type ${TYPE} -iregex "${@:?}" -print
    (set -x; ${FIND} -maxdepth ${DEPTH} ${PRUNE} -type ${TYPE} -iregex "$XB${1:?}$XE" -print)
else
    (set -x; fd --max-depth ${DEPTH} --type ${TYPE} --ignore-case "${@:?}" "${QFD}")
fi
echo ${0##*/} done. >&2
